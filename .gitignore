# OpenClaw Portable v7 — Git Ignore

# ============================================
# Runtime state (created by start scripts, never committed)
# ============================================
data/

# NOTE: config/openclaw.json IS committed — it is the v7 template with
# __GATEWAY_PORT__/__OLLAMA_PORT__/__MODEL_PRIMARY__ placeholders. Do NOT
# ignore it (v6 ignored it, which is why the v6.0.2 release shipped broken).

# ============================================
# Model weights (shipped via GitHub releases, not git)
# ============================================
models/*.gguf
models/*.gguf.part*
*.part1
*.part2

# ============================================
# Bundled runtimes (shipped via CI, not git)
# ============================================
node/
openclaw-pkg/
ollama/
llm/

# ============================================
# Logs / temp / system
# ============================================
*.log
logs/
.temp/
.tmp/
*.tmp
*.swp
*.swo
*~
.DS_Store
Thumbs.db
desktop.ini
*.bak
*.backup
*.old

# ============================================
# Build outputs
# ============================================
dist/
*.tar
*.tar.gz
*.zip

# IDE
.vscode/
.idea/
*.iml
.task-card.md
.review.md
